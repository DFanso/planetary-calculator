{
  "name": "astronex",
  "version": "1.0.0",
  "description": "ASTRONEX - Planetary Weight & Age Calculator for Kids",
  "module": "index.js",
  "type": "module",
  "bin": {
    "astronex": "./index.js"
  },
  "scripts": {
    "start": "bun index.js",
    "build:mac": "bun build index.js --compile --outfile astronex-macos",
    "build:win": "bun build index.js --compile --outfile astronex.exe --target bun-windows-x64 --windows-icon=logo.ico",
    "build:linux": "bun build index.js --compile --outfile astronex-linux --target bun-linux-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^6.8.0",
    "ink-gradient": "^4.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4",
    "react-devtools-core": "^7.0.1",
    "react-dom": "^19.2.4"
  }
}
